{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ticket_booking_db;Username=postgres;Password=postgres",
    "RedisConnection": "localhost:6379"
  },
  "ThreadPool": {
    "MinWorkerThreads": 32,
    "MinIocpThreads": 32
  },
  "Cache": {
    "Enabled": true,
    "CatalogTtlSeconds": 300,
    "TicketsTtlSeconds": 30,
    "TtlJitterPercent": 10,
    "CircuitBreakSeconds": 15,
    "OperationTimeoutMs": 2000,
    "InvalidationRetryDelayMs": 1000
  },
  "Jwt": {
    "Issuer": "TicketBooking.Api",
    "Audience": "TicketBooking.Clients",
    "SigningKey": "dev-only-signing-key-change-me-in-production-0123456789",
    "ExpiresMinutes": 60
  }
}
